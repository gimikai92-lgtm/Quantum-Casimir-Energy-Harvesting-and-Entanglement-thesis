# Example environment variables for API keys and secrets
# Do NOT commit real secrets. Copy this to `.env` and fill values.

# Generic service API key
SERVICE_API_KEY=your_service_api_key_here

# S3 or object storage credentials (if used)
S3_ACCESS_KEY_ID=your_access_key_id
S3_SECRET_ACCESS_KEY=your_secret_access_key
S3_BUCKET=your_bucket_name

# Docker Hub (for CI pushes)
DOCKERHUB_USERNAME=your_dockerhub_username
DOCKERHUB_TOKEN=your_dockerhub_token

# Optional: Rust/Python integration tokens
RUST_INTEGRATION_TOKEN=your_rust_token
PYTHON_INTEGRATION_TOKEN=your_python_token
